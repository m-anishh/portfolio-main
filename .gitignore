.temp/
tmp/
temp/

# Private keys, certificates, and credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*credentials*.json
*service-account*.json
secrets/

# Operating-system and editor files
.DS_Store
Thumbs.db
